{
  "name": "Okta - Joiner",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "okta-joiner",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1000001-0000-4000-8000-000000000001",
      "name": "Joiner Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "okta-joiner-lab"
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "f1", "name": "firstName", "value": "={{ $json.body?.firstName ?? $json.firstName }}", "type": "string" },
            { "id": "f2", "name": "lastName", "value": "={{ $json.body?.lastName ?? $json.lastName }}", "type": "string" },
            { "id": "f3", "name": "email", "value": "={{ ($json.body?.email ?? $json.email).toLowerCase() }}", "type": "string" },
            { "id": "f4", "name": "department", "value": "={{ $json.body?.department ?? $json.department }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "a1000001-0000-4000-8000-000000000002",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "url": "=https://integrator-9879407.okta.com/api/v1/groups?q={{ encodeURIComponent($json.department) }}&limit=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "a1000001-0000-4000-8000-000000000003",
      "name": "Find Department Group",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "exists", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000001-0000-4000-8000-000000000004",
      "name": "Group Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://integrator-9879407.okta.com/api/v1/users?activate=true",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ profile: { firstName: $('Normalize Input').first().json.firstName, lastName: $('Normalize Input').first().json.lastName, email: $('Normalize Input').first().json.email, login: $('Normalize Input').first().json.email }, groupIds: [ $json.id ] }) }}",
        "options": {}
      },
      "id": "a1000001-0000-4000-8000-000000000005",
      "name": "Create and Activate User",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, -100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'created', id: $json.id, login: $json.profile.login, oktaStatus: $json.status }) }}",
        "options": {}
      },
      "id": "a1000001-0000-4000-8000-000000000006",
      "name": "Respond Created",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1100, -100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'error', message: 'No matching Okta group for department', department: $('Normalize Input').first().json.department }) }}",
        "options": { "responseCode": 400 }
      },
      "id": "a1000001-0000-4000-8000-000000000007",
      "name": "Respond No Group",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [880, 100]
    }
  ],
  "connections": {
    "Joiner Webhook": { "main": [[{ "node": "Normalize Input", "type": "main", "index": 0 }]] },
    "Normalize Input": { "main": [[{ "node": "Find Department Group", "type": "main", "index": 0 }]] },
    "Find Department Group": { "main": [[{ "node": "Group Found?", "type": "main", "index": 0 }]] },
    "Group Found?": {
      "main": [
        [{ "node": "Create and Activate User", "type": "main", "index": 0 }],
        [{ "node": "Respond No Group", "type": "main", "index": 0 }]
      ]
    },
    "Create and Activate User": { "main": [[{ "node": "Respond Created", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
