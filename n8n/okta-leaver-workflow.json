{
  "name": "Okta - Leaver",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "okta-leaver",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "b2000002-0000-4000-8000-000000000001",
      "name": "Leaver Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "okta-leaver-lab"
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "f1", "name": "email", "value": "={{ ($json.body?.email ?? $json.email).toLowerCase() }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "b2000002-0000-4000-8000-000000000002",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "url": "=https://integrator-9879407.okta.com/api/v1/users/{{ encodeURIComponent($json.email) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "b2000002-0000-4000-8000-000000000003",
      "name": "Find User",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://integrator-9879407.okta.com/api/v1/users/{{ $('Find User').first().json.id }}/lifecycle/suspend",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "b2000002-0000-4000-8000-000000000004",
      "name": "Suspend User",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "=https://integrator-9879407.okta.com/api/v1/users/{{ $('Find User').first().json.id }}/sessions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "b2000002-0000-4000-8000-000000000005",
      "name": "Clear Sessions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "url": "=https://integrator-9879407.okta.com/api/v1/users/{{ $('Find User').first().json.id }}/groups",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "b2000002-0000-4000-8000-000000000006",
      "name": "List User Groups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 0],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.type }}",
              "rightValue": "OKTA_GROUP",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2000002-0000-4000-8000-000000000007",
      "name": "Only Assignable Groups",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [1320, 0]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "=https://integrator-9879407.okta.com/api/v1/groups/{{ $json.id }}/users/{{ $('Find User').first().json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "b2000002-0000-4000-8000-000000000008",
      "name": "Remove From Group",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 0]
    }
  ],
  "connections": {
    "Leaver Webhook": { "main": [[{ "node": "Normalize Input", "type": "main", "index": 0 }]] },
    "Normalize Input": { "main": [[{ "node": "Find User", "type": "main", "index": 0 }]] },
    "Find User": { "main": [[{ "node": "Suspend User", "type": "main", "index": 0 }]] },
    "Suspend User": { "main": [[{ "node": "Clear Sessions", "type": "main", "index": 0 }]] },
    "Clear Sessions": { "main": [[{ "node": "List User Groups", "type": "main", "index": 0 }]] },
    "List User Groups": { "main": [[{ "node": "Only Assignable Groups", "type": "main", "index": 0 }]] },
    "Only Assignable Groups": { "main": [[{ "node": "Remove From Group", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
